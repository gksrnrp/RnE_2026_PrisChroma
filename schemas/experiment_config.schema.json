{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "experiment_config.schema.json",
  "title": "Draft line-width experiment configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "config_version",
    "status",
    "human_data_collection_allowed",
    "task",
    "observer_profile",
    "display",
    "line",
    "coordinates",
    "color_design",
    "calibration",
    "validation",
    "staircase",
    "sampling",
    "model_plan",
    "privacy",
    "timing"
  ],
  "properties": {
    "schema_version": {"const": "0.1-draft"},
    "config_version": {"type": "string", "minLength": 1},
    "status": {"const": "draft"},
    "human_data_collection_allowed": {"const": false},
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "layout", "choice_count", "practice_feedback", "main_feedback"],
      "properties": {
        "type": {"const": "4afc_odd_one_out"},
        "layout": {"const": "2x2"},
        "choice_count": {"const": 4},
        "practice_feedback": {"type": "boolean"},
        "main_feedback": {"type": "boolean"}
      }
    },
    "observer_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "participant_id",
        "cvd_type",
        "severity",
        "severity_source",
        "severity_session_id",
        "fixed_lapse",
        "lapse_source",
        "lapse_session_id"
      ],
      "properties": {
        "participant_id": {"type": "string", "pattern": "^P[0-9A-Za-z_-]+$"},
        "cvd_type": {"enum": ["protan", "deutan"]},
        "severity": {"type": "number", "minimum": 0, "maximum": 1},
        "severity_source": {"type": "string", "minLength": 1},
        "severity_session_id": {"type": "string", "minLength": 1},
        "fixed_lapse": {"type": "number", "minimum": 0, "exclusiveMaximum": 0.2},
        "lapse_source": {"type": "string", "minLength": 1},
        "lapse_session_id": {"type": "string", "minLength": 1}
      }
    },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "width_mm",
        "resolution_width_px",
        "resolution_height_px",
        "os_scale_percent",
        "app_scale_percent",
        "viewing_distance_mm",
        "background_rgb",
        "color_profile",
        "calibration_id",
        "luminance_cd_m2"
      ],
      "properties": {
        "model": {"type": "string", "minLength": 1},
        "width_mm": {"type": "number", "exclusiveMinimum": 0},
        "resolution_width_px": {"type": "integer", "minimum": 1},
        "resolution_height_px": {"type": "integer", "minimum": 1},
        "os_scale_percent": {"type": "number", "exclusiveMinimum": 0},
        "app_scale_percent": {"type": "number", "exclusiveMinimum": 0},
        "viewing_distance_mm": {"type": "number", "exclusiveMinimum": 0},
        "background_rgb": {"$ref": "#/$defs/rgb"},
        "color_profile": {"type": "string", "minLength": 1},
        "calibration_id": {"type": "string", "minLength": 1},
        "luminance_cd_m2": {"type": ["number", "null"], "exclusiveMinimum": 0}
      }
    },
    "line": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "length_px",
        "orientation_deg",
        "cap",
        "antialiasing",
        "renderer",
        "pixel_snapping"
      ],
      "properties": {
        "length_px": {"type": "integer", "minimum": 1},
        "orientation_deg": {"type": "number", "minimum": -360, "maximum": 360},
        "cap": {"enum": ["butt", "round", "square"]},
        "antialiasing": {"type": "string", "minLength": 1},
        "renderer": {"type": "string", "minLength": 1},
        "pixel_snapping": {"type": "string", "minLength": 1}
      }
    },
    "coordinates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["positions_px", "center_spacing_px"],
      "properties": {
        "positions_px": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {"type": "number", "minimum": 0}
          }
        },
        "center_spacing_px": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "color_design": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stimulus_family_id",
        "midpoint_lab",
        "direction_lab",
        "symmetric_about_midpoint",
        "gamut_policy",
        "rgb_quantization",
        "target_absolute_tolerance_delta_e00",
        "target_relative_tolerance",
        "search_grid_steps"
      ],
      "properties": {
        "stimulus_family_id": {"type": "string", "minLength": 1},
        "midpoint_lab": {"$ref": "#/$defs/lab"},
        "direction_lab": {"$ref": "#/$defs/lab"},
        "symmetric_about_midpoint": {"const": true},
        "gamut_policy": {"const": "reject"},
        "rgb_quantization": {"const": "nearest_8bit"},
        "target_absolute_tolerance_delta_e00": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Absolute acceptance tolerance for generating stimulus levels after 8-bit quantization. It is not an upper bound on a path-correction candidate's target overshoot."
        },
        "target_relative_tolerance": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 1,
          "description": "Relative acceptance tolerance for generating stimulus levels after 8-bit quantization. It does not relax or upper-bound the path-correction C80 constraint."
        },
        "search_grid_steps": {"type": "integer", "minimum": 32}
      }
    },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["widths", "trials_per_width", "session_block_count"],
      "properties": {
        "widths": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"$ref": "#/$defs/rendered_width"}
        },
        "trials_per_width": {"const": [96, 192, 96]},
        "session_block_count": {"enum": [4, 6]}
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidates", "independent_staircases", "trials_per_staircase"],
      "properties": {
        "candidates": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["geometric_target_px", "rendered_width_px", "width_deg"],
            "properties": {
              "geometric_target_px": {"type": "number", "exclusiveMinimum": 0},
              "rendered_width_px": {"type": "integer", "minimum": 1},
              "width_deg": {"type": "number", "exclusiveMinimum": 0}
            }
          }
        },
        "independent_staircases": {"type": "integer", "minimum": 1},
        "trials_per_staircase": {"type": "integer", "minimum": 1}
      }
    },
    "staircase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "starting_delta_e00",
        "minimum_delta_e00",
        "maximum_delta_e00",
        "update_rule",
        "lapse_policy",
        "fixed_lapse"
      ],
      "properties": {
        "method": {"type": "string", "minLength": 1},
        "starting_delta_e00": {"type": "number", "exclusiveMinimum": 0},
        "minimum_delta_e00": {"type": "number", "minimum": 0},
        "maximum_delta_e00": {"type": "number", "exclusiveMinimum": 0},
        "update_rule": {"type": "string", "minLength": 1},
        "lapse_policy": {"enum": ["fixed", "shared", "estimated"]},
        "fixed_lapse": {"type": ["number", "null"], "minimum": 0, "maximum": 0.19}
      }
    },
    "sampling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["delta_e00_levels", "randomization", "practice_trials"],
      "properties": {
        "delta_e00_levels": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "uniqueItems": true,
          "items": {"type": "number", "exclusiveMinimum": 0}
        },
        "randomization": {"type": "string", "minLength": 1},
        "practice_trials": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "model_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["models", "include_szafir_transfer", "szafir_probability_coordinate"],
      "properties": {
        "models": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["B192", "B384", "C192", "D384"]}
        },
        "include_szafir_transfer": {"type": "boolean"},
        "szafir_probability_coordinate": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1}
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approved",
        "approval_id",
        "approved_at_utc",
        "consent_version",
        "pseudonymization",
        "storage_policy"
      ],
      "properties": {
        "approved": {"const": false},
        "approval_id": {"type": ["string", "null"], "minLength": 1},
        "approved_at_utc": {"type": ["string", "null"], "format": "date-time"},
        "consent_version": {"type": ["string", "null"], "minLength": 1},
        "pseudonymization": {"type": ["string", "null"], "minLength": 1},
        "storage_policy": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixation_ms",
        "inter_trial_ms",
        "response_deadline_policy",
        "response_deadline_ms"
      ],
      "properties": {
        "fixation_ms": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "inter_trial_ms": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "response_deadline_policy": {
          "type": ["string", "null"],
          "enum": ["fixed", "unlimited", null]
        },
        "response_deadline_ms": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "active_trial_abort_policy": {
          "enum": ["invalidate-analysis-no-retry", null]
        },
        "incomplete_block_time_limit_policy": {
          "enum": ["invalidate-participant-dataset-no-retry", null]
        }
      }
    }
  },
  "$defs": {
    "rgb": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"type": "integer", "minimum": 0, "maximum": 255}
    },
    "lab": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"type": "number"}
    },
    "rendered_width": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width_px", "width_deg"],
      "properties": {
        "width_px": {"type": "integer", "minimum": 1},
        "width_deg": {"type": "number", "exclusiveMinimum": 0}
      }
    }
  }
}
